{
  "$comment": "For a Vercel project whose Root Directory is the repository root: builds the marketing site (apps/site) as a static export. A project with Root Directory apps/site uses apps/site/vercel.json instead. apps/mcp-server is not deployable to Vercel; it runs from the Dockerfile.",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @power/protocol build && NEXT_PUBLIC_POWER_APP_URL=${NEXT_PUBLIC_POWER_APP_URL:-https://app.usepower.dev} pnpm build:site",
  "outputDirectory": "apps/site/out",
  "framework": null,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ]},
    { "source": "/_next/static/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
