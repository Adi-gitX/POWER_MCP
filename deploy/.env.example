# Production environment for deploy/docker-compose.yml.
#
#   cp .env.example .env
#
# Nothing here has a safe default. Every line is required except where it says
# otherwise, and the server refuses to start without POWER_SECRET_KEY off
# loopback rather than pretending secrets are encrypted.

# The domain, already pointing at this machine. Caddy asks Let's Encrypt for a
# certificate on first boot, so this has to resolve before the stack starts.
POWER_DOMAIN=mcp.example.com

# The public origin, with the scheme. Every discovery document is built from it.
# POWER_MCP_URL is derived as <issuer>/mcp and must equal, byte for byte, what
# a person types into Claude.
POWER_ISSUER_URL=https://mcp.example.com

# Previews are served here, and nothing of Power's own is. Point a second
# hostname at this machine. Without it a generated app shares an origin with
# the forms that authorise a publish and can confirm its own.
POWER_PREVIEW_HOST=preview.mcp.example.com

# Managed Postgres for the control plane: accounts, OAuth tokens, projects and
# secrets. Without it each container keeps its own copy and loses all of it on
# the next deploy.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 32 bytes, base64. Encrypts every stored credential.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy somewhere safe: losing it means losing every stored secret.
POWER_SECRET_KEY=

# Sign-in links. Without a key they are written to the container log, which is
# fine for you and useless for anyone else.
RESEND_API_KEY=
POWER_MAIL_FROM=Power <login@mcp.example.com>

# `vercel` asks each user for their own hosting token the first time they
# publish, and stores it encrypted against their account. `local` writes the
# release to disk and serves it, which is for development.
POWER_DEPLOYER=vercel

# Quota across more than one container. Not needed on a single machine, where
# in-process counting is correct because there is only one process.
# REDIS_URL=

# Never set these off loopback. The server refuses them anyway; they are listed
# so it is obvious they must not be copied here from a development .env.
# POWER_DEV_AUTH=
# POWER_DEV_LOGIN=
