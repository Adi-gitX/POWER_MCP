{
  "name": "power",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test",
    "clean": "tsc --build --clean",
    "dev": "pnpm --filter @power/mcp-server dev",
    "e2e": "pnpm --filter @power/mcp-server e2e",
    "build:web": "pnpm --filter @power/site build",
    "dev:web": "pnpm --filter @power/site dev",
    "build:site": "pnpm --filter @power/site build",
    "dev:site": "pnpm --filter @power/site dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
